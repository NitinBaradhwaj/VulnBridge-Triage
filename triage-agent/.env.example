# Copy this file to .env (or just export these in your shell) before running
# agent.py without --dry-run.
#
# GITHUB_TOKEN needs "repo" scope (classic PAT) or "Issues: write" +
# "Metadata: read" (fine-grained PAT) on the target repo.
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
